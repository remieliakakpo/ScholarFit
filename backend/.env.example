# Copie ce fichier en .env et adapte les valeurs.
DATABASE_URL=sqlite:///./bourses.db
# DATABASE_URL=postgresql+psycopg://bourses:bourses@localhost:5432/bourses
SECRET_KEY=change-moi-avec-une-longue-chaine-aleatoire
CORS_ORIGINS=http://localhost:3000
ADMIN_EMAILS=admin@example.org
# Comptes de démo du README (admin, demo, conseiller) recréés à chaque démarrage. false en production.
DEMO_ACCOUNTS=true

# E-mails du compte (confirmation de l'adresse, mot de passe oublié).
# Sans SMTP_HOST, les e-mails et leurs liens sont écrits dans la fenêtre de l'API.
SITE_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ScholarFit <no-reply@votre-domaine.com>
SMTP_SSL=false

# Supervision : suivi des erreurs (Sentry ou compatible, ex. GlitchTip). Vide = désactivé.
SENTRY_DSN=
# Coût de l'IA (dollars US, tarifs Claude Opus 5.5 par million de jetons) et plafond de dépense par jour
# (0 = pas de plafond ; au-delà, l'IA est coupée jusqu'au lendemain et les règles hors-ligne prennent le relais)
AI_PRICE_INPUT_PER_MTOK=4.0
AI_PRICE_OUTPUT_PER_MTOK=20.0
AI_PRICE_CACHE_READ_PER_MTOK=0.20
AI_PRICE_CACHE_WRITE_PER_MTOK=5.0
# Estimation, à vérifier dans la grille tarifaire d'Anthropic
AI_PRICE_PER_WEB_SEARCH=0.01
AI_DAILY_BUDGET_USD=0
# Collecte : extraction, mise en forme et traduction par lots (moitié prix, réponse en moins de 24 h)
AI_USE_BATCH=true
# Réutiliser une réponse identique de l'IA (diagnostic de CV, conseils, chat) pendant ce nombre de jours
AI_CACHE_DAYS=30
# Extraction des annonces en deux temps : premier passage par un modèle économique, contrôle sans IA
# (preuves recopiées de la page, date limite, niveau), relecture par le modèle principal des seules fiches douteuses
EXTRACT_MODEL=claude-haiku-5-5
# Vide = CLAUDE_MODEL
REVIEW_MODEL=
# Tarifs du modèle économique (Claude Haiku 5.5, dollars par million de jetons ; lecture du cache estimée)
AI_PRICE_SMALL_INPUT_PER_MTOK=0.10
AI_PRICE_SMALL_OUTPUT_PER_MTOK=0.50
AI_PRICE_SMALL_CACHE_READ_PER_MTOK=0.01
# Premier passage sur une machine à vous avec Ollama (gratuit à l'usage) : EXTRACT_PROVIDER=ollama
EXTRACT_PROVIDER=claude
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# IA (facultatif). Sans clé, la plateforme marche en mode hors-ligne (règles et modèles).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
AI_FREE_GENERATIONS_PER_DAY=20

# Collecte
SCRAPER_USER_AGENT=ScholarFitBot/0.1 (+https://ton-site.example/bot)
SCRAPER_MIN_DELAY_SECONDS=5

# Accompagnement : true = conseiller attribué automatiquement, false = choix par un administrateur
COACHING_AUTO_ASSIGN=true

# Offres d'accompagnement (prix en F CFA)
OFFER_STANDARD_PRICE=15000
OFFER_PREMIUM_PRICE=35000

# Collecte automatique pendant que l'API tourne : sources, découverte IA dans le monde entier,
# vérification des liens, expirations, alertes. 0 = désactivée (planifier alors « python -m app.cli nightly »).
AUTO_COLLECT_HOURS=24
# Stages ONU, ONG et organisations internationales : demandez un nom d'application sur https://apidoc.reliefweb.int
RELIEFWEB_APPNAME=
# Découverte de bourses par l'IA (nécessite ANTHROPIC_API_KEY) et nombre de recherches web par zone
AI_DISCOVERY_ENABLED=true
AI_DISCOVERY_MAX_SEARCHES=6

# CV et lettres : dossiers offerts, abonnement mensuel (prix F CFA, durée en jours, dossiers par période), relances par dossier
DOC_FREE_PACKS=1
SUBSCRIPTION_PRICE=2500
SUBSCRIPTION_DAYS=30
SUBSCRIPTION_MONTHLY_PACKS=10
DOC_PACK_REGENERATIONS=3
# Numéros qui reçoivent les paiements
PAYMENT_FLOOZ_NUMBER=+228 98 64 55 43
PAYMENT_MIXX_NUMBER=+228 91 12 75 84

# ---------- Mise en ligne ----------
# Adresse publique de l'API (notifications CinetPay). SITE_URL est plus haut.
API_PUBLIC_URL=http://localhost:8000

# Paiement en ligne : simulation (essais, aucun argent ne circule) | cinetpay | manuel (désactivé)
PAYMENT_PROVIDER=simulation
# Tableau de bord CinetPay > Intégrations : clé API, identifiant du site et clé secrète
CINETPAY_APIKEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=

# Moyen d'envoi des e-mails : console | smtp | brevo | resend (vide = smtp si SMTP_HOST est rempli, sinon console).
# L'expéditeur est SMTP_FROM (plus haut), quel que soit le moyen d'envoi.
EMAIL_BACKEND=
EMAIL_REPLY_TO=
BREVO_API_KEY=
RESEND_API_KEY=

# Version définitive : en ligne, mettez APP_ENV=production (comptes de démo désactivés,
# paiement simulé bloqué, clé de signature aléatoire si SECRET_KEY est absent).
APP_ENV=
# Suivi des erreurs (facultatif) : DSN d'un projet Sentry
SENTRY_DSN=
