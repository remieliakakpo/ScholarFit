# Copie ce fichier en .env et adapte les valeurs.
# dev = poste de développement (comptes de démo, /docs, cookie sans Secure). Toute autre valeur =
# production : l'API refuse alors de démarrer avec une SECRET_KEY faible ou reprise de ce fichier.
APP_ENV=dev
DATABASE_URL=sqlite:///./bourses.db
# DATABASE_URL=postgresql+psycopg://bourses:bourses@localhost:5432/bourses
# Production : python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-moi-avec-une-longue-chaine-aleatoire
CORS_ORIGINS=http://localhost:3000
# Adresse publique du site (liens des e-mails de vérification et de mot de passe oublié)
FRONTEND_URL=http://localhost:3000
# Deviennent administrateurs une fois leur adresse confirmée (ou : python -m app.cli create-admin EMAIL)
ADMIN_EMAILS=admin@example.org
# Relais dont on lit X-Forwarded-For (le serveur Next.js) ; « * » seulement si l'API n'est pas joignable directement
TRUSTED_PROXIES=127.0.0.1,::1

# E-mails. Sans SMTP_HOST : rien n'est envoyé, le message s'affiche dans la console de l'API (APP_ENV=dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ScholarFit <no-reply@example.org>
SMTP_STARTTLS=true

# Supervision : suivi des erreurs (Sentry ou compatible, ex. GlitchTip). Vide = désactivé.
SENTRY_DSN=
# Coût de l'IA (dollars US, tarifs Claude Opus 5.5 par million de jetons) et plafond de dépense par jour
# (0 = pas de plafond ; au-delà, l'IA est coupée jusqu'au lendemain et les règles hors-ligne prennent le relais)
AI_PRICE_INPUT_PER_MTOK=4.0
AI_PRICE_OUTPUT_PER_MTOK=20.0
AI_PRICE_CACHE_READ_PER_MTOK=0.20
AI_PRICE_CACHE_WRITE_PER_MTOK=5.0
# Estimation, à vérifier dans la grille tarifaire d'Anthropic
AI_PRICE_PER_WEB_SEARCH=0.01
AI_DAILY_BUDGET_USD=0

# IA (facultatif). Sans clé, la plateforme marche en mode hors-ligne (règles et modèles).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
AI_FREE_GENERATIONS_PER_DAY=20

# Collecte
SCRAPER_USER_AGENT=ScholarFitBot/0.1 (+https://ton-site.example/bot)
SCRAPER_MIN_DELAY_SECONDS=5

# Accompagnement : true = conseiller attribué automatiquement, false = choix par un administrateur
COACHING_AUTO_ASSIGN=true

# Offres d'accompagnement (prix en F CFA)
OFFER_STANDARD_PRICE=15000
OFFER_PREMIUM_PRICE=35000

# Collecte automatique pendant que l'API tourne : sources, découverte IA dans le monde entier,
# vérification des liens, expirations, alertes. 0 = désactivée (planifier alors « python -m app.cli nightly »).
AUTO_COLLECT_HOURS=24
# Stages ONU, ONG et organisations internationales : demandez un nom d'application sur https://apidoc.reliefweb.int
RELIEFWEB_APPNAME=
# Découverte de bourses par l'IA (nécessite ANTHROPIC_API_KEY) et nombre de recherches web par zone
AI_DISCOVERY_ENABLED=true
AI_DISCOVERY_MAX_SEARCHES=6

# CV et lettres : dossiers offerts, abonnement mensuel (prix F CFA, durée en jours, dossiers par période), relances par dossier
DOC_FREE_PACKS=1
SUBSCRIPTION_PRICE=2500
SUBSCRIPTION_DAYS=30
SUBSCRIPTION_MONTHLY_PACKS=10
DOC_PACK_REGENERATIONS=3
# Numéros qui reçoivent les paiements
PAYMENT_FLOOZ_NUMBER=+228 98 64 55 43
PAYMENT_MIXX_NUMBER=+228 91 12 75 84
