# Adresse de l'API vue par le serveur Next.js (relais /api et pages bourses rendues côté serveur)
API_URL_INTERNAL=http://127.0.0.1:8000
# À laisser vide en local : le navigateur passe par /api sur le même port que le site.
# NEXT_PUBLIC_API_URL=https://api.mon-domaine.org
# Adresse publique du site : liens absolus des aperçus partagés (WhatsApp, Facebook…) et de l'application installable
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Activer le service worker (hors ligne) aussi en développement (sinon : seulement après « npm run build »)
# NEXT_PUBLIC_ENABLE_SW=1
